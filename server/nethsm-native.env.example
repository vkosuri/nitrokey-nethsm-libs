# /etc/nethsm-native/nethsm-native.env — read by nethsm-native.service.
# Upstream Nitrokey/nethsm checkout that has already completed `make build`.
NETHSM_SRC=/opt/nethsm
# Account that owns the OPAM switch and runs `make run`. Use root only if
# your upstream revision requires it for TAP or KVM access.
NETHSM_RUN_USER=nethsm
OPAMROOT=/home/nethsm/.opam
# OPAMSWITCH=nethsm
# Command run inside the OPAM environment from NETHSM_SRC.
NETHSM_RUN_CMD=make run
# 1 runs tools/setup-net-dev.sh (as root) before each start.
NETHSM_SETUP_NET=1
# Client-reachable port forwarded to the instance's HTTPS API. Must equal
# the GitHub environment's NETHSM_PORT. Set 0 to disable forwarding.
NETHSM_LISTEN_PORT=8443
NETHSM_UPSTREAM=192.168.1.1:443
